// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum BusType {
  AC_SEATER
  AC_SLEEPER
  NON_AC_SEATER
  NON_AC_SLEEPER
}

enum Deck {
  LOWER
  UPPER
}

enum SeatType {
  SEATER
  SLEEPER
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  COMPLETED
  FAILED
}

model User {
  id                 String              @id @default(uuid())
  name               String
  phone              String
  email              String              @unique
  passwordHash       String
  role               Role                @default(CUSTOMER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  bookings           Booking[]
  payments           Payment[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Operator {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  buses     Bus[]
}

model Bus {
  id         String     @id @default(uuid())
  operatorId String
  operator   Operator   @relation(fields: [operatorId], references: [id])
  name       String
  busType    BusType
  totalSeats Int
  seats      Seat[]
  schedules  Schedule[]
}

model Seat {
  id            String         @id @default(uuid())
  busId         String
  bus           Bus            @relation(fields: [busId], references: [id])
  seatNumber    String
  deck          Deck
  seatType      SeatType
  row           Int
  column        Int
  scheduleSeats ScheduleSeat[]

  @@unique([busId, seatNumber])
}

model Route {
  id          String     @id @default(uuid())
  source      String
  destination String
  distanceKm  Int?
  schedules   Schedule[]
}

model Schedule {
  id             String           @id @default(uuid())
  busId          String
  bus            Bus              @relation(fields: [busId], references: [id])
  routeId        String
  route          Route            @relation(fields: [routeId], references: [id])
  departureTime  DateTime
  arrivalTime    DateTime
  fare           Decimal          @db.Decimal(10, 2)
  serviceCharge  Decimal          @default(0) @db.Decimal(10, 2)
  boardingPoints BoardingPoint[]
  droppingPoints DroppingPoint[]
  scheduleSeats  ScheduleSeat[]
  bookings       Booking[]
}

model ScheduleSeat {
  id           String     @id @default(uuid())
  scheduleId   String
  schedule     Schedule   @relation(fields: [scheduleId], references: [id])
  seatId       String
  seat         Seat       @relation(fields: [seatId], references: [id])
  status       SeatStatus @default(AVAILABLE)
  heldByUserId String?
  heldAt       DateTime?
  expiresAt    DateTime?
  bookedAt     DateTime?
  bookingId    String?
  booking      Booking?   @relation(fields: [bookingId], references: [id])

  @@unique([scheduleId, seatId])
}

model BoardingPoint {
  id         String    @id @default(uuid())
  scheduleId String
  schedule   Schedule  @relation(fields: [scheduleId], references: [id])
  name       String
  time       DateTime
  bookings   Booking[]
}

model DroppingPoint {
  id         String    @id @default(uuid())
  scheduleId String
  schedule   Schedule  @relation(fields: [scheduleId], references: [id])
  name       String
  time       DateTime
  bookings   Booking[]
}

model Booking {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  scheduleId      String
  schedule        Schedule      @relation(fields: [scheduleId], references: [id])
  pnr             String        @unique
  status          BookingStatus @default(CONFIRMED)
  totalFare       Decimal       @db.Decimal(10, 2)
  seatNumbers     String[]
  boardingPointId String
  boardingPoint   BoardingPoint @relation(fields: [boardingPointId], references: [id])
  droppingPointId String
  droppingPoint   DroppingPoint @relation(fields: [droppingPointId], references: [id])
  seats           ScheduleSeat[]
  createdAt       DateTime      @default(now())
  cancelledAt     DateTime?
  checkedInAt     DateTime?
  payment         Payment?
}

model Payment {
  id              String        @id @default(uuid())
  bkashPaymentId  String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  scheduleId      String
  seatNumbers     String[]
  boardingPointId String
  droppingPointId String
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(INITIATED)
  bookingId       String?       @unique
  booking         Booking?      @relation(fields: [bookingId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
